<div class="flex flex--col flex--stretch-x w--full h--full gap--none">
  {% if current and current.temperature %}
  <div class="flex flex--col flex--stretch-x flex--center-y gap--none" style="flex:1;">
    {% render "weather_current_compact", current: current, icon_size: 48 %}
    <div class="pt--4 pr--1.5 pb--1 pl--2" style="flex:1; min-height:0;">
      {% render "weather_daily_bars_vertical", daily_entries: daily.entries, inset_top: 0, current_temp: current.temperature, abbreviate_days: meta.abbreviate_days %}
    </div>
  </div>
  {% elsif error %}
  <div class="flex flex--col flex--center-y gap--none" style="flex:1;">
    <i class="wi wi-na text--gray-50 wi-sz-48"></i>
    <div class="title mt--2" data-pixel-perfect="true">{{ error.message }}</div>
  </div>
  {% else %}
  <div class="flex flex--col flex--center-y gap--none" style="flex:1;">
    <i class="wi wi-na text--gray-50 wi-sz-48"></i>
    <div class="title mt--2" data-pixel-perfect="true">No weather data.</div>
  </div>
  {% endif %}
  {% render "title_bar", short_time: true, plugin_name: trmnl.plugin_settings.instance_name, updated_at: current.time, icon_class: current.icon_class, cache: meta.cache, time_format: meta.time_format %}
</div>
