<style>
.screen--lg [id^="chart-hourly-"] { height: 380px !important; }
.screen--portrait [id^="chart-hourly-"] { height: 300px !important; }
</style>
<div class="flex flex--col flex--stretch-x w--full h--full gap--none">
  {% if current and current.temperature %}
  <div class="flex portrait:flex--col gap--[16px] lg:gap--large" style="flex:1; min-height:0;">
    <div class="flex flex--col flex--stretch-x flex--between gap--none pt--8 lg:pt--12 w--[64cqw] portrait:w--full">
      {% render "weather_current", current: current %}
      {% render "weather_hourly_chart", hourly: hourly, daily: daily, current_time: current.time, chart_height: 230, time_format: meta.time_format %}
    </div>
    <div class="flex flex--col flex--stretch-x pt--4 lg:pt--6 pr--1.5 pb--4 lg:pb--8 gap--none w--[36cqw] portrait:w--[75cqw] portrait:flex-auto" style="min-height:0;">
      {% render "weather_daily_bars_vertical", daily_entries: daily.entries, current_temp: current.temperature, abbreviate_days: meta.abbreviate_days %}
    </div>
  </div>
  {% elsif error %}
  <div class="flex flex--col flex--center-y gap--none" style="flex:1;">
    <i class="wi wi-na text--gray-50 wi-sz-xl"></i>
    <div class="title mt--4" data-pixel-perfect="true">{{ error.message }}</div>
    {% if error.hint %}
    <div class="description mt--2" data-pixel-perfect="true">{{ error.hint }}</div>
    {% endif %}
  </div>
  {% else %}
  <div class="flex flex--col flex--center-y gap--none" style="flex:1;">
    <i class="wi wi-na text--gray-50 wi-sz-xl"></i>
    <div class="title mt--4" data-pixel-perfect="true">No weather data available.</div>
  </div>
  {% endif %}
  {% render "title_bar", plugin_name: trmnl.plugin_settings.instance_name, updated_at: current.time, icon_class: current.icon_class, provider: meta.provider, cache: meta.cache, time_format: meta.time_format, place: place %}
</div>
