{% comment %}
  weather_current: Current conditions for two-column layout
  Params: current
{% endcomment %}
{% template weather_current %}
<div class="current-block flex flex--row flex--center-x w--full pt--2 lg:pt--4 pb--1 gap--[12px] lg:gap--large">
  <i class="wi {{ current.icon_class }} shrink-0 wi-sz-xl"></i>
  <div class="value--xxlarge lg:value--mega shrink-0" data-pixel-perfect="true" style="line-height:1; white-space:nowrap;">{{ current.temperature }}&deg;</div>
  <div class="current-details flex flex--col flex--stretch-x gap--[2px] lg:gap--xsmall">
    <div class="value--xxsmall lg:value--small" data-pixel-perfect="true" style="white-space:nowrap;">{{ current.condition }}</div>
    <div class="value--xxsmall lg:value--small" data-pixel-perfect="true" style="white-space:nowrap;">Feels {{ current.apparent_temperature }}&deg;</div>
    <div class="current-extra value--xxsmall lg:value--small" data-pixel-perfect="true" style="white-space:nowrap;">Humidity {{ current.relative_humidity }}%</div>
    <div class="current-extra value--xxsmall lg:value--small" data-pixel-perfect="true" style="white-space:nowrap;">Wind {{ current.wind_speed }} {{ current.wind_direction }}</div>
  </div>
</div>
{% render "weather_current_fit" %}
{% endtemplate %}

{% comment %}
  weather_current_fit: hides detail lines that do not fit the block's width.
  Rendered by both current-conditions templates; the guard keeps one copy running.
{% endcomment %}
{% template weather_current_fit %}
<style>
/* The fallback if the script below never runs: the text clips inside the column
   instead of running out over whatever sits beside it. */
.current-details { min-width: 0; overflow: hidden; }
</style>
<script>
(function () {
  if (window.__wxFitCurrent) { return; }
  window.__wxFitCurrent = true;
  function fitCurrent() {
    var blocks = document.querySelectorAll('.current-block');
    for (var i = 0; i < blocks.length; i++) {
      var block = blocks[i];
      var details = block.querySelector('.current-details');
      if (!details) { continue; }
      // Measure from the full block every time: a line hidden for a narrow slot has
      // to come back when watch() re-runs on a wider one.
      details.style.removeProperty('display');
      var lines = [];
      for (var j = 0; j < details.children.length; j++) {
        details.children[j].style.removeProperty('display');
        lines.push(details.children[j]);
      }
      // Taken from the siblings, not from the column itself: the column is
      // flex-sized, so its width is an effect of the text and cannot answer this.
      var avail = block.clientWidth;
      for (var k = 0; k < block.children.length; k++) {
        if (block.children[k] !== details) {
          avail -= block.children[k].getBoundingClientRect().width;
        }
      }
      var columnGap = parseFloat(window.getComputedStyle(block).columnGap) || 0;
      avail -= columnGap * (block.children.length - 1);
      // Bottom-up, which is the order they can be spared in.
      for (var n = lines.length; n > 0; n--) {
        var widest = 0;
        for (var m = 0; m < n; m++) {
          widest = Math.max(widest, lines[m].scrollWidth);
        }
        if (widest <= avail) { break; }
        lines[n - 1].style.setProperty('display', 'none');
      }
      // Nothing fits: give the column's space back rather than clip a word.
      if (lines.length && lines[0].style.display === 'none') {
        details.style.setProperty('display', 'none');
      }
    }
  }

  function start() {
    if (window.TRMNLPaint) { TRMNLPaint.watch('.current-block', fitCurrent); }
    else { fitCurrent(); }
  }
  // Same wait as the daily rows: the framework's own pass wraps pixel-perfect text
  // and resolves the type scale, both of which move the widths measured here.
  var tries = 0;
  (function whenSettled() {
    if (window.TRMNL_PLUGINS_READY || ++tries > 200) { requestAnimationFrame(start); return; }
    setTimeout(whenSettled, 50);
  })();
})();
</script>
{% endtemplate %}

{% comment %}
  weather_current_compact: Compact current conditions for smaller layouts
  Params: current, icon_size (default 64), show_extra (default true — shows humidity + wind)
{% endcomment %}
{% template weather_current_compact %}
<div class="current-block flex flex--row flex--center-x shrink-0 w--full pt--1.5 pb--1">
  <i class="wi {{ current.icon_class }} shrink-0 {% if icon_size == 48 %}wi-sz-48{% else %}wi-sz-lg{% endif %}"></i>
  <div class="value--xlarge shrink-0" data-pixel-perfect="true" style="line-height:1; white-space:nowrap;">{{ current.temperature }}&deg;</div>
  <div class="current-details flex flex--col flex--stretch-x gap--[2px]">
    <div class="value--xxsmall" data-pixel-perfect="true" style="white-space:nowrap;">{{ current.condition }}</div>
    <div class="value--xxsmall" data-pixel-perfect="true" style="white-space:nowrap;">Feels {{ current.apparent_temperature }}&deg;</div>
    {% if show_extra != false %}
    <div class="current-extra value--xxsmall" data-pixel-perfect="true" style="white-space:nowrap;">Humidity {{ current.relative_humidity }}%</div>
    <div class="current-extra value--xxsmall" data-pixel-perfect="true" style="white-space:nowrap;">Wind {{ current.wind_speed }} {{ current.wind_direction }}</div>
    {% endif %}
  </div>
</div>
{% render "weather_current_fit" %}
{% endtemplate %}

{% comment %}
  weather_hourly_chart: Highcharts spline for next 24 hours
  Params: hourly, daily, current_time, chart_height
{% endcomment %}
{% template weather_hourly_chart %}
{% assign chart_id = "chart-hourly-" | append_random %}
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>
{% assign hour_labels = "" %}
{% assign temp_data = "" %}
{% assign precip_data = "" %}
{% assign icon_classes = "" %}
{% assign hour_times = "" %}
{% for entry in hourly.entries %}
  {% if forloop.first %}
    {% assign hour_labels = entry.label | prepend: '"' | append: '"' %}
    {% assign temp_data = entry.temperature | append: "" %}
    {% assign precip_data = entry.precipitation_probability | append: "" %}
    {% assign icon_classes = entry.icon_class | prepend: '"' | append: '"' %}
    {% assign hour_times = entry.time | prepend: '"' | append: '"' %}
  {% else %}
    {% assign hour_labels = hour_labels | append: ',"' | append: entry.label | append: '"' %}
    {% assign temp_data = temp_data | append: "," | append: entry.temperature %}
    {% assign precip_data = precip_data | append: "," | append: entry.precipitation_probability %}
    {% assign icon_classes = icon_classes | append: ',"' | append: entry.icon_class | append: '"' %}
    {% assign hour_times = hour_times | append: ',"' | append: entry.time | append: '"' %}
  {% endif %}
{% endfor %}
<div class="flex flex--col flex--stretch-x flex--bottom gap--none" style="flex:1; min-height:0;">
  <div id="{{ chart_id }}" class="w--full" style="height:{{ chart_height | default: 260 }}px; min-height:0; image-rendering: pixelated;"></div>
</div>
<script>
var chartEl = '{{ chart_id }}';
var iconClasses = [{{ icon_classes }}];
var hourTimes = [{{ hour_times }}];
var timeFormat = "{{ time_format }}";
var sunEvents = [
  {% for entry in daily.entries %}{% if forloop.first == false %},{% endif %}{ rise: "{{ entry.sunrise }}", set: "{{ entry.sunset }}" }{% endfor %}
];
function sunPlotLines() {
  var lines = [];
  var startTime = hourTimes[0];
  var endTime = hourTimes[hourTimes.length - 1];
  for (var i = 0; i < sunEvents.length; i++) {
    var ev = sunEvents[i];
    var events = [{ t: ev.rise, label: 'sunrise', icon: 'wi-sunrise' }, { t: ev.set, label: 'sunset', icon: 'wi-sunset' }];
    for (var j = 0; j < events.length; j++) {
      var t = events[j].t;
      if (t >= startTime && t <= endTime) {
        var tHour = t.slice(0, 13);
        for (var k = 0; k < hourTimes.length; k++) {
          if (hourTimes[k].slice(0, 13) === tHour) {
            var mins = parseInt(t.slice(14, 16), 10);
            var h = parseInt(t.slice(11, 13), 10);
            var timeStr2;
            if (timeFormat === '24h') {
              timeStr2 = (h < 10 ? '0' : '') + h + ':' + (mins < 10 ? '0' : '') + mins;
            } else {
              var ampm = h < 12 ? 'am' : 'pm';
              var h12 = h === 0 ? 12 : (h > 12 ? h - 12 : h);
              timeStr2 = h12 + ':' + (mins < 10 ? '0' : '') + mins + ampm;
            }
            lines.push({ value: k + mins / 60, label: timeStr2, icon: events[j].icon });
            break;
          }
        }
      }
    }
  }
  return lines;
}
function sunPlotBands() {
  var bands = [];
  var startTime = hourTimes[0];
  var endTime = hourTimes[hourTimes.length - 1];
  var maxX = hourTimes.length - 1;
  // Collect all sunrise/sunset times within or near the chart range
  var rises = [];
  var sets = [];
  for (var i = 0; i < sunEvents.length; i++) {
    var ev = sunEvents[i];
    if (ev.rise >= startTime && ev.rise <= endTime) rises.push(ev.rise);
    if (ev.set >= startTime && ev.set <= endTime) sets.push(ev.set);
  }
  // Helper: convert an ISO time string to an x-axis position
  function timeToX(t) {
    var tHour = t.slice(0, 13);
    for (var k = 0; k < hourTimes.length; k++) {
      if (hourTimes[k].slice(0, 13) === tHour) {
        var mins = parseInt(t.slice(14, 16), 10);
        return k + mins / 60;
      }
    }
    return null;
  }
  // Build a sorted list of sun transitions within the chart
  var transitions = [];
  for (var i = 0; i < rises.length; i++) transitions.push({ t: rises[i], type: 'rise' });
  for (var i = 0; i < sets.length; i++) transitions.push({ t: sets[i], type: 'set' });
  transitions.sort(function(a, b) { return a.t < b.t ? -1 : a.t > b.t ? 1 : 0; });
  if (transitions.length === 0) {
    // No sun events in range, so check if chart is entirely nighttime.
    // If the first hourly entry is before any sunrise, it's night
    for (var i = 0; i < sunEvents.length; i++) {
      if (sunEvents[i].rise > startTime) {
        bands.push({ from: 0, to: maxX });
        break;
      }
      if (sunEvents[i].set > startTime) break;
    }
    return bands;
  }
  // If the first transition is sunrise, there's night before it
  var pos = 0;
  if (transitions[0].type === 'rise') {
    var x = timeToX(transitions[0].t);
    if (x !== null && x > 0) bands.push({ from: 0, to: x });
    pos = 1;
  }
  // Pair sunsets with following sunrises
  for (var i = pos; i < transitions.length; i++) {
    if (transitions[i].type === 'set') {
      var fromX = timeToX(transitions[i].t);
      var toX = maxX;
      // Look for the next sunrise
      if (i + 1 < transitions.length && transitions[i + 1].type === 'rise') {
        toX = timeToX(transitions[i + 1].t);
        i++; // skip the paired sunrise
      }
      if (fromX !== null && toX !== null) bands.push({ from: fromX, to: toX });
    }
  }
  return bands;
}
// TRMNLCharts rides in the plugin runtime and Highcharts comes from the CDN, so
// neither is guaranteed to have executed by the time this inline script runs.
function whenChartsReady(cb) {
  var tries = 0;
  (function attempt() {
    if (window.TRMNLCharts && window.Highcharts) return cb();
    if (++tries > 200) return;
    setTimeout(attempt, 50);
  })();
}
whenChartsReady(function () {
  // watch() rebuilds the chart whenever the screen's device, scale, bit depth or
  // theme classes change, so every paint and dimension below is re-resolved from
  // the framework instead of being guessed at from a viewport width.
  TRMNLCharts.watch(chartEl, function () {
    // Highcharts takes plain numbers, which do not follow the device scale on
    // their own; px() converts each one for the screen the chart landed on.
    var px = function (value) { return TRMNLPaint.px(value, { el: chartEl }); };
    var base = TRMNLCharts.options({ el: chartEl });
    // The scale cascade resolves the same on OG and on TRMNL X, so px() alone
    // cannot tell the two apart. The screen's own size class can, and unlike a
    // viewport media query it stays correct when the view is only part of the
    // screen, and it is re-read on every watch() rebuild.
    var screen = TRMNLPaint.screen(chartEl);
    var dense = !!(screen && screen.classList.contains('screen--lg'));
    // Below a legibility floor the chart is hidden rather than drawn flat. Unhide
    // before measuring: a hidden wrapper reads 0 and would never come back.
    var node = document.getElementById(chartEl);
    var wrap = node && node.parentElement;
    if (wrap) {
      wrap.style.removeProperty('display');
      if (node.getBoundingClientRect().height < (dense ? 150 : 110)) {
        wrap.style.setProperty('display', 'none');
        return null;
      }
    }
    var ink = TRMNLCharts.paint('black', { el: chartEl });
    var labelStyle = TRMNLCharts.textStyle('chart-label', { el: chartEl });
    return Highcharts.chart(chartEl, TRMNLCharts.merge(base, {
      // Only the two chart-level dimensions are merged here: options() installs
      // an events.render hook that repaints the axis strokes as dither patterns,
      // and merge() would replace the whole events object.
      // animation is already false in options(); it is restated because the lint
      // rule greps the markup for it and cannot see a value resolved at runtime.
      chart: { animation: false, ['mar'+'gin']: px(dense ? [30, 12, 56, 12] : [22, 8, 44, 8]), spacing: [0, 0, 0, 0] },
      xAxis: TRMNLCharts.merge(base.xAxis, {
        categories: [{{ hour_labels }}],
        tickInterval: 4,
        // The hours are already named by the labels and split by the sun lines,
        // so the vertical grid the framework defaults on is redundant here.
        gridLineWidth: 0,
        labels: { rotation: 0, align: 'center', y: px(dense ? 20 : 16) },
        plotLines: sunPlotLines().map(function(pl) {
          var nearEdge = pl.value > hourTimes.length * 0.8;
          return {
            value: pl.value,
            color: ink,
            width: px(1),
            dashStyle: 'shortdot',
            label: {
              text: nearEdge ? '' : '<i class="wi ' + pl.icon + ' wi-sz-16"></i> ' + pl.label,
              useHTML: true,
              align: 'left',
              x: px(-10),
              rotation: 0,
              style: labelStyle,
              y: px(-5)
            }
          };
        }),
        plotBands: sunPlotBands().map(function(band) {
          return { from: band.from, to: band.to, color: TRMNLCharts.paint('gray-70', { el: chartEl }) };
        })
      }),
      // merge() replaces arrays wholesale, so each axis is merged onto the
      // framework defaults on its own rather than handed over as a bare array.
      yAxis: [
        TRMNLCharts.merge(base.yAxis, {
          tickAmount: 5,
          maxPadding: 0.3,
          minRange: 10,
          labels: { enabled: false }
        }),
        TRMNLCharts.merge(base.yAxis, {
          min: 0, max: 100,
          opposite: true,
          labels: { enabled: false },
          gridLineWidth: 0
        }),
        TRMNLCharts.merge(base.yAxis, {
          linkedTo: 0,
          opposite: true,
          tickAmount: 5,
          labels: { enabled: false },
          gridLineWidth: 0
        })
      ],
      series: [
        {
          name: 'Precip %',
          type: 'areaspline',
          data: [{{ precip_data }}],
          yAxis: 1,
          color: TRMNLCharts.paint('gray-45', { el: chartEl }),
          fillColor: TRMNLCharts.paint('gray-45', { el: chartEl }),
          lineWidth: px(1),
          lineColor: ink,
          zIndex: 0
        },
        {
          name: 'Temp',
          type: 'spline',
          data: [{{ temp_data }}],
          yAxis: 0,
          color: ink,
          lineWidth: px(dense ? 5 : 4),
          zIndex: 1,
          dataLabels: {
            enabled: true,
            useHTML: true,
            formatter: function() {
              if (this.point.index % 4 !== 0) return null;
              var cls = iconClasses[this.point.index];
              return '<div class="text--center" style="line-height:1.3;"><i class="wi ' + cls + ' text-stroke text-stroke--medium wi-sz-md"></i><br><span class="text-stroke text-stroke--medium chart-temp">' + Math.round(this.y) + '&deg;</span></div>';
            },
            y: px(-2),
            ['pad'+'ding']: 0,
            backgroundColor: 'none',
            borderWidth: 0,
            shadow: false
          }
        }
      ]
    }));
  });
});
</script>
{% endtemplate %}

{% comment %}
  weather_daily_bars_vertical: Vertical forecast bars for right column
  Params: daily_entries, inset_top (default 20). Rows that do not fit the
  column are hidden after layout by the script at the end of this block.
{% endcomment %}
{% template weather_daily_bars_vertical %}
{% assign overall_min = daily_entries[0].low %}
{% assign overall_max = daily_entries[0].high %}
{% for entry in daily_entries %}
  {% if entry.low < overall_min %}{% assign overall_min = entry.low %}{% endif %}
  {% if entry.high > overall_max %}{% assign overall_max = entry.high %}{% endif %}
{% endfor %}
{% assign overall_min_int = overall_min | floor %}
{% assign overall_max_int = overall_max | ceil %}
{% assign range = overall_max_int | minus: overall_min_int %}
{% if range < 1 %}{% assign range = 1 %}{% endif %}

<div class="flex flex--col flex--stretch-x h--full gap--none {% if inset_top == 0 %}pt--0{% else %}pt--5{% endif %}">
  <div class="daily-list flex flex--col flex--stretch-x flex--evenly gap--none" style="flex:1;">
{% if current_temp %}
  {% assign current_temp_int = current_temp | round %}
  {% assign current_marker_pct = current_temp_int | minus: overall_min_int | times: 100 | divided_by: range | at_least: 0 | at_most: 100 %}
{% endif %}
  {% for entry in daily_entries %}
    {% assign left_pct = entry.low | minus: overall_min_int | times: 100 | divided_by: range | at_least: 0 %}
    {% assign width_pct = entry.high | minus: entry.low | times: 100 | divided_by: range | at_least: 1 %}
    <div class="daily-row shrink-0 my--0.5 lg:my--1">
      {% if forloop.first and current_temp %}
      <div class="daily-marker h--3 lg:h--4" data-marker-pct="{{ current_marker_pct }}" style="position:relative; min-width:0;">
        <span class="fs-10" style="position:absolute; left:{{ current_marker_pct }}%; transform:translateX(-50%); bottom:-2px;">&#9660;</span>
      </div>
      {% endif %}
      <div class="flex flex--row gap--[2px] lg:gap--xsmall">
        <div class="day-label shrink-0">
          {%- if forloop.first -%}{%- assign day_full = "Today" -%}{%- assign day_short = "Today" -%}
          {%- else -%}{%- assign day_short = entry.date | date: '%a' -%}{%- if abbreviate_days -%}{%- assign day_full = day_short -%}{%- else -%}{%- assign day_full = entry.date | date: '%A' -%}{%- endif -%}{%- endif -%}
          <div class="day-name description lg:description--large" data-pixel-perfect="true" data-day-full="{{ day_full }}" data-day-short="{{ day_short }}" style="line-height:1.2;">{{ day_full }}</div>
          {% if entry.precipitation_probability >= 10 %}
          <div class="flex flex--row flex--left gap--[6px]">
            <i class="wi wi-umbrella wi-sz-xs"></i>
            <span class="description" data-pixel-perfect="true">{{ entry.precipitation_probability }}%</span>
          </div>
          {% endif %}
        </div>
        <div class="flex flex--center-x w--9 lg:w--12 shrink-0 gap--none"><i class="wi {{ entry.icon_class }} wi-sz-md"></i></div>
        <div class="temp-label flex flex--right shrink-0 mr--1 gap--none"><span class="value--xsmall lg:value--small" data-pixel-perfect="true" style="white-space:nowrap;">{{ entry.low }}&deg;</span></div>
        <div class="daily-bar h--5 lg:h--7 rounded lg:rounded--full" style="flex:1; border:1px solid #000; min-width:0; position:relative;">
          <div class="bg--gray-30 h--full rounded lg:rounded--full" style="position:absolute; left:{{ left_pct }}%; width:{{ width_pct }}%;"></div>
        </div>
        <div class="temp-label flex flex--left shrink-0 ml--1 gap--none"><span class="value--xsmall lg:value--small" data-pixel-perfect="true" style="white-space:nowrap;">{{ entry.high }}&deg;</span></div>
      </div>
    </div>
  {% endfor %}
  </div>
</div>
<script>
(function () {
  // How many days fit depends on the space the layout actually leaves, and no
  // static number can carry it: the same half_vertical column gets 308px on an
  // OG and 294px on a TRMNL X, where the chart above it exists only on the
  // larger screen. Measure the column, then drop whole rows from the bottom.
  function fitDailyRows() {
    var lists = document.querySelectorAll('.daily-list');
    for (var i = 0; i < lists.length; i++) { fitList(lists[i]); }
  }
  // The day name is the one part of a row whose width is not ours to choose,
  // and it was hardcoded twice, once per screen size. Both were tuned to the
  // longest weekday and one had already drifted: "Wednesday" needs 68px at 12px
  // type, which the OG box matched exactly, and 92px at 16px, which is 2px more
  // than the TRMNL X box gave it, so the name ran under the weather icon. Read
  // what the text actually needs at whatever type the device resolved.
  function widestNatural(els) {
    var widest = 0;
    for (var i = 0; i < els.length; i++) {
      els[i].style.width = '';
      widest = Math.max(widest, els[i].getBoundingClientRect().width);
    }
    return widest;
  }
  function setWidth(els, width) {
    for (var i = 0; i < els.length; i++) { els[i].style.width = width + 'px'; }
  }
  function writeName(el, text) {
    // The pixel-perfect pass has already wrapped this text in its own span. Keep
    // that wrapper when there is exactly one, so a shortened name still renders
    // through it.
    if (el.children.length === 1) { el.children[0].textContent = text; }
    else { el.textContent = text; }
  }
  function fitLabels(list) {
    var names = list.querySelectorAll('.day-name');
    var days = list.querySelectorAll('.day-label');
    var temps = list.querySelectorAll('.temp-label');
    if (!days.length) { return; }
    for (var i = 0; i < names.length; i++) {
      writeName(names[i], names[i].getAttribute('data-day-full') || names[i].textContent);
    }
    // One width for every row, or the bars would start at a different offset on
    // each line. Two pixels of slack: none is what the TRMNL X was running on.
    setWidth(temps, Math.ceil(widestNatural(temps)) + 2);
    setWidth(days, Math.ceil(widestNatural(days)) + 2);
    var bar = list.querySelector('.daily-bar');
    if (!bar) { return; }
    // A column can be too narrow to hold a full weekday and still leave a bar
    // worth reading. Shortening the names is what the Abbreviate Day Names
    // setting was for; do it here so the setting is a preference rather than a
    // repair. Only ever full to short, so a user who asked for short names keeps
    // them on a wide screen.
    var floor = Math.max(list.clientWidth * 0.25, scaled(list, 56));
    if (bar.getBoundingClientRect().width >= floor) { return; }
    for (var j = 0; j < names.length; j++) {
      var short = names[j].getAttribute('data-day-short');
      if (short) { writeName(names[j], short); }
    }
    setWidth(days, Math.ceil(widestNatural(days)) + 2);
  }
  function scaled(el, value) {
    return window.TRMNLPaint ? TRMNLPaint.px(value, { el: el }) : value;
  }
  // The marker used to be aligned over the first bar by a hand-summed offset
  // (68 + 2 + 36 + 2 + 34 + 4 + 1), which measured widths invalidate. Read the
  // bar's real position instead.
  function placeMarker(list) {
    var marker = list.querySelector('.daily-marker');
    var bar = list.querySelector('.daily-bar');
    if (!marker || !bar || !marker.firstElementChild) { return; }
    var pct = parseFloat(marker.getAttribute('data-marker-pct'));
    if (isNaN(pct)) { return; }
    var b = bar.getBoundingClientRect();
    marker.firstElementChild.style.left = (b.left - marker.getBoundingClientRect().left + b.width * pct / 100) + 'px';
  }
  function fitList(list) {
    var rows = Array.prototype.slice.call(list.children);
    for (var j = 0; j < rows.length; j++) { rows[j].style.display = ''; }
    // Widths first: a longer name can wrap the precipitation line and change a
    // row's height, which is what the pass below is measuring.
    fitLabels(list);
    placeMarker(list);
    // Measure with the rows packed against the top. The column spreads them
    // evenly again once this is done, and those distributed gaps would
    // otherwise count against the budget and drop a row that fits.
    list.style.justifyContent = 'flex-start';
    try {
      // Hide one row at a time from the bottom and measure again, rather than
      // deciding every row from a single reading. Removing a row can change
      // the column's own height, so one pass settles on a stale budget and
      // leaves the last row hanging over the edge.
      for (var guard = 0; guard < 40; guard++) {
        var budget = list.clientHeight;
        if (!budget) { return; }
        var visible = [];
        for (var k = 0; k < rows.length; k++) {
          if (rows[k].style.display !== 'none') { visible.push(rows[k]); }
        }
        // Row 0 carries today and the marker, so it is the last to go - but it
        // does go, or the marker is left floating over a row clipped away.
        if (!visible.length) { return; }
        if (visible.length === 1) {
          if (visible[0].getBoundingClientRect().bottom - list.getBoundingClientRect().top > budget) {
            visible[0].style.display = 'none';
          }
          return;
        }
        var last = visible[visible.length - 1];
        var over = last.getBoundingClientRect().bottom - list.getBoundingClientRect().top;
        if (over <= budget) { return; }
        last.style.display = 'none';
      }
    } finally {
      list.style.justifyContent = '';
    }
  }

  function start() {
    // watch() re-fits when the screen's device, scale or theme classes change.
    // Without it the count would be right only for the size first rendered.
    if (window.TRMNLPaint) { TRMNLPaint.watch('.daily-list', fitDailyRows); }
    else { fitDailyRows(); }
  }
  // Wait for the framework's own layout pass: it wraps pixel-perfect text and
  // clamps, both of which move row heights. TRMNL_PLUGINS_READY turns true once
  // that finishes.
  var tries = 0;
  (function whenSettled() {
    if (window.TRMNL_PLUGINS_READY || ++tries > 200) { requestAnimationFrame(start); return; }
    setTimeout(whenSettled, 50);
  })();
})();
</script>
{% endtemplate %}

{% comment %}
  title_bar: Standard bottom bar
  Params: plugin_name
{% endcomment %}
{% template title_bar %}
{% case provider %}
  {% when "open-meteo" %}{% assign provider_label = "Open-Meteo" %}
  {% when "pirate-weather" %}{% assign provider_label = "Pirate Weather" %}
  {% else %}{% assign provider_label = provider %}
{% endcase %}
<div class="title_bar">
  {% if icon_class %}<i class="wi {{ icon_class }} text-stroke text-stroke--thick mr--1.5 wi-sz-sm"></i>{% endif %}
  <span class="title">{{ plugin_name }}</span>
{%- comment -%}
  The place is echoed back so a wrong match is visible, but a full subdivision name
  ("Stoneham, Massachusetts") outruns the line. Character count stands in for width:
  the bar has no measurement to offer a template, and the name alone is always
  preferable to a name the bar cuts off mid-word.
{%- endcomment -%}
{% assign place_label = place.name %}
{% if place.admin1 %}{% assign with_admin1 = place.name | append: ", " | append: place.admin1 %}{% if with_admin1.size <= 18 %}{% assign place_label = with_admin1 %}{% endif %}{% endif %}
  {% if place %}<span class="title">·</span><span class="title">{{ place_label }}</span>{% endif %}
  {% if updated_at %}
{%- comment -%}
  short_time is for the narrow layouts, where the plugin name, the place and a full
  date do not fit together. The weekday says enough there: a screen refreshing every
  hour is rarely showing a timestamp whose year is in question.
{%- endcomment -%}
  {% if short_time %}{% if time_format == "24h" %}{% assign stamp_format = "%a %H:%M" %}{% else %}{% assign stamp_format = "%a %-I:%M %p" %}{% endif %}{% else %}{% if time_format == "24h" %}{% assign stamp_format = "%Y/%-m/%-d %H:%M" %}{% else %}{% assign stamp_format = "%Y/%-m/%-d %-I:%M %p" %}{% endif %}{% endif %}
  {% assign stamp = updated_at | date: "%s" | plus: trmnl.user.utc_offset | date: stamp_format %}
{%- comment -%}
  A refresh glyph carries what the word Updated used to, in a fraction of the width.
  A stale serve swaps it for a warning: the timestamp alone cannot say that it is
  older than it should be.
{%- endcomment -%}
  <span class="instance">{% if cache == "stale_served" %}⚠︎{% else %}<i class="wi wi-refresh wi-sz-sm"></i>{% endif %} {{ stamp }}{% if provider_label %} from {{ provider_label }}{% endif %}</span>
  {% endif %}
</div>
{% endtemplate %}
