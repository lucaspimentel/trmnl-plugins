<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <!-- Ahead of what Microsoft.Data.Sqlite pulls in: the 2.1.x native bundle carries a known
         high-severity SQLite advisory (GHSA-2m69-gcr7-jv3q). Bump the two together. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- IANA tzdb 2026c, verbatim from https://data.iana.org/time-zones/tzdb/zone.tab.
         Public domain. Refreshed by replacing the file; see TimeZoneCountry for why this is the
         deprecated zone.tab rather than zone1970.tab. -->
    <EmbeddedResource Include="zone.tab" LogicalName="TrmnlApi.Geo.zone.tab" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrmnlApi.Tests" />
  </ItemGroup>

</Project>
