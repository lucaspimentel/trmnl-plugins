# Environment variables used by this repo. Copy to .env and fill in.
#   cp .env.example .env && set -a && source .env && set +a
# Run tools/setup-env.sh first; it installs the toolchain and creates this copy.
# .env is gitignored. Secrets live in 1Password item "trmnl"; deployment secrets
# live in the host's variable store (sealed, write-only) and are not read from here.

# ---------------------------------------------------------------------------
# TRMNL account / device (plugin tooling)
# ---------------------------------------------------------------------------

# Personal API key for `trmnlp login` / `trmnlp push` (tools/push-plugin.sh).
# 1Password: op item get trmnl --fields label=TRMNL_API_KEY --reveal
TRMNL_API_KEY=

# Device credentials used by tools/Trmnl.Cli (current-screen fetch) and
# tools/Get-Trmnl-Image.ps1.
# 1Password: op item get trmnl --fields label=TRMNL_DEVICE_ID,label=TRMNL_DEVICE_API_KEY --reveal
TRMNL_DEVICE_ID=
TRMNL_DEVICE_API_KEY=

# ---------------------------------------------------------------------------
# api/ — TrmnlApi (ASP.NET Core). Required for `dotnet run --project api/src/TrmnlApi`.
# ASP.NET config keys use `__` for nesting; a bare number in a TimeSpan parses
# as DAYS, so always write hh:mm:ss.
# ---------------------------------------------------------------------------

# REQUIRED. Comma-separated provider list; first entry is the default, the list
# is the fallback order. Values: open-meteo, pirate-weather
WeatherProviders=open-meteo,pirate-weather

# Provider keys. Open-Meteo works without a key on the free tier; Pirate Weather
# throws at startup of its client if unset, so leave it blank only when that
# provider is not in WeatherProviders.
OPEN_METEO_API_KEY=
PIRATE_WEATHER_API_KEY=

# Forecast cache (defaults: 00:10:00 / 02:00:00 / 2000).
WeatherCache__FreshTtl=00:10:00
WeatherCache__StaleTtl=02:00:00
WeatherCache__SizeLimit=2000

# Resolved-place cache (defaults: 7 days / 24h).
PlaceCache__HitTtl=7.00:00:00
PlaceCache__MissTtl=24:00:00

# Bundled geographic dataset (TrmnlApi.Geo). Blank or missing path = local
# geocoding and the on-screen location switch off and every query goes to the
# vendor geocoder; the service still boots. Build one with
# api/tools/GeoDataBuilder, or point at a downloaded geo.sqlite.
Geo__DatabasePath=
Geo__TimeBudget=00:00:00.250
Geo__CityRadiusKm=60

# Kestrel / hosting.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# ---------------------------------------------------------------------------
# api/ — Datadog APM. Off by default locally; see api/docs/observability.md.
# ---------------------------------------------------------------------------

DD_TRACE_ENABLED=false
DD_SERVICE=trmnl-api
DD_ENV=local
DD_VERSION=
# Agent endpoint. Unset locally unless an agent is running.
DD_TRACE_AGENT_URL=
# Direct log submission (deploy-time only): needs both of these plus an entry in
# Logging:Datadog:LogLevel in api/src/TrmnlApi/appsettings.json.
DD_LOGS_DIRECT_SUBMISSION_INTEGRATIONS=
DD_SITE=datadoghq.com
DD_API_KEY=

# ---------------------------------------------------------------------------
# api/Dockerfile build args (pass with --build-arg, not as runtime env vars)
# ---------------------------------------------------------------------------

# DD_TRACER_VERSION must be >= the Datadog.Trace package version in TrmnlApi.csproj.
DD_TRACER_VERSION=3.52.0
# Pinned geo dataset asset (.gz) and the sha256 of the DECOMPRESSED sqlite file.
GEO_DATA_URL=
GEO_DATA_SHA256=
