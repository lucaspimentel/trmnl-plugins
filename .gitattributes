* text=auto

# Set line endings to LF, even on Windows. Otherwise, execution within Docker fails.
# See https://help.github.com/articles/dealing-with-line-endings/
*.sh text eol=lf
*.bash text eol=lf

# A verbatim upstream copy. Leaving it alone keeps it byte-identical to
# https://data.iana.org/time-zones/tzdb/zone.tab, so a refresh is a clean diff.
api/src/TrmnlApi.Geo/zone.tab -text